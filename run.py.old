import sys
sys.dont_write_bytecode = True

from flask import Flask, session, redirect, url_for
from functools import wraps
from flask_socketio import SocketIO
from flask_session import Session
import redis

from app.views import init_dashboard, init_authentification, init_sondes, init_scan_report, init_admin_tools

# Initialisation de l'application
app = Flask(__name__, template_folder='app/templates', static_folder='app/static')

# Configuration de Redis pour stocker les sessions
app.config['SESSION_TYPE'] = 'redis'  # Utilisation de Redis pour les sessions
app.config['SESSION_PERMANENT'] = False  # Sessions non permanentes
app.config['SESSION_USE_SIGNER'] = True  # Signature des sessions pour plus de sécurité
app.config['SESSION_KEY_PREFIX'] = 'seahawk_nester_'  # Préfixe pour identifier les sessions
app.config['SESSION_REDIS'] = redis.StrictRedis(host='localhost', port=6379, db=0)  # Connexion au serveur Redis

# Initialiser la session Flask
Session(app)

# Configurations doivent être placées APRÈS initialisation de Flask
app.config["DEBUG"] = True
app.config["ENV"] = "development"
app.secret_key = 'super secret key'

# Initialisation de SocketIO
socketio = SocketIO(app, async_mode="gevent")

# Initialisation des différentes parties de l'application
init_authentification(app)
init_dashboard(app)
init_sondes(app, socketio)
init_scan_report(app)
init_admin_tools(app)

if __name__ == '__main__':
    socketio.run(app, debug=True, host="0.0.0.0", port=5000)  # Lancer l'application en mode debug

